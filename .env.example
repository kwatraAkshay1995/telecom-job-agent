# n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
# Required because the workflow references GEMINI_* via $env inside n8n nodes.
# Fine for this local single-user V0. Prefer n8n credentials before multi-user deployment.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Google Gemini Developer API
# Keep the real key only in your local .env file. Never commit it.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash-lite
